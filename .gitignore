### OSX ###
.worktrees/

.DS_Store
.AppleDouble
.LSOverride


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns


# Intellij
*.iml
.idea

# VsCode
.vscode/*

# Claude Code local settings
.claude/

# MkDocs build output
site/
site-qa/

# Auto-generated product index pages (created by scripts/generate_product_index.py)
docs/**/*/index.md
!docs/zh/index.md
!docs/en/index.md

# llms-full.txt is a deploy-time artifact (several MB per language;
# regenerated by CI, committing it would bloat git history)
docs/*/llms-full.txt

# Python
__pycache__/
*.pyc
*.pyo

# Vim
*.swp
*.swo

# Environment variables
.env
.env.local

# Specs build output
dist/

# Audit reports
AUDIT_REPORT.md
AI_READINESS_REPORT.md
TODO_AI_READINESS.md

# Internal documentation (not for public)
内部文档.md
INTERNAL.md
site-*/

# WP credentials (generated at runtime from GitHub Secrets)
auto-import/onboarding/highlights-import/config.json
auto-import/onboarding/specs-import/config.json

# Product-level nav files (build-time generated by scripts/generate_nav_files.py;
# the hand-maintained top-level docs/<lang>/.nav.yml files are NOT ignored)
docs/*/*/.nav.yml
