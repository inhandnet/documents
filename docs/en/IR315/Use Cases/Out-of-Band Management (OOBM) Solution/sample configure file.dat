openvpn_ovpn4=##############################################\0A# Sample client-side OpenVPN 2.0 config file #\0A# for connecting to multi-client server.     #\0A#                                            #\0A# This configuration can be used by multiple #\0A# clients, however each client should have   #\0A# its own cert and key files.                #\0A#                                            #\0A# On Windows, you might want to rename this  #\0A# file so it has a .ovpn extension           #\0A##############################################\0A\0A# Specify that we are a client and that we\0A# will be pulling certain config file directives\0A# from the server.\0Aclient\0A\0A# Use the same setting as you are using on\0A# the server.\0A# On most systems, the VPN will not function\0A# unless you partially or fully disable\0A# the firewall for the TUN/TAP interface.\0A;dev tap\0Adev tun1\0A\0A# Windows needs the TAP-Win32 adapter name\0A# from the Network Connections panel\0A# if you have more than one.  On XP SP2,\0A# you may need to disable the firewall\0A# for the TAP adapter.\0A;dev-node MyTap\0A\0A# Are we connecting to a TCP or\0A# UDP server?  Use the same setting as\0A# on the server.\0A;proto tcp\0Aproto udp\0A\0A# The hostname/IP and port of the server.\0A# You can have multiple remote entries\0A# to load balance between the servers.\0Aremote www.hostvpn.cloud 45507\0A\0A# Choose a random host from the remote\0A# list for load-balancing.  Otherwise\0A# try hosts in the order specified.\0A;remote-random\0A\0A# Keep trying indefinitely to resolve the\0A# host name of the OpenVPN server.  Very useful\0A# on machines which are not permanently connected\0A# to the internet such as laptops.\0Aresolv-retry infinite\0A\0A# Most clients don't need to bind to\0A# a specific local port number.\0Anobind\0A\0A# Downgrade privileges after initialization (non-Windows only)\0A;user nobody\0A;group nobody\0A\0A# Try to preserve some state across restarts.\0Apersist-key\0Apersist-tun\0A\0A# If you are connecting through an\0A# HTTP proxy to reach the actual OpenVPN\0A# server, put the proxy server/IP and\0A# port number here.  See the man page\0A# if your proxy server requires\0A# authentication.\0A;http-proxy-retry # retry on connection failures\0A;http-proxy [proxy server] [proxy port #]\0A\0A# Wireless networks often produce a lot\0A# of duplicate packets.  Set this flag\0A# to silence duplicate packet warnings.\0A;mute-replay-warnings\0A\0A# SSL/TLS parms.\0A# See the server config file for more\0A# description.  It's best to use\0A# a separate .crt/.key file pair\0A# for each client.  A single ca\0A# file can be used for all clients.\0A;ca ca.crt\0A;cert zly.crt\0A;key zly.key\0A<key>\0A-----BEGIN RSA PRIVATE KEY-----\0AMIIEowIBAAKCAQEAqyeGd0IMCNo/IeYdryj+SVRrqWsSV8485fCh6uV5ikqInA2Q\0AJmfJ46i8GmmN8w4JmlIMpy1yj/+Pgp6RyKV0URD79j7+uqwS3revrv8vEtRTJlrJ\0Arft6M/Jvr0rWU9C11hMwRWVx1U2ZVNnphgN503Vk+/o95VGklvCEy6MfnhUv4FNH\0An/kVFQad0QYVJzrA1ZkOujj8G0d9kwEW23yNQQl0DAA8NRcpaLSnQTLz53dI0h8c\0Ax9ol4zu9OzCH6RCw5ZDQDe3dgFhw7H60Xdc7cj+tNcndF61TsO47wJ45nY6jidcV\0A7rDW3cbIqQU76B77dh14+t6rdw8FexE4kGTv7wIDAQABAoIBAFClLxbCaClDrLus\0AUhBWoHqs7I3Hhb0Z0FgIKkMkHUCsHfJp8aInBVngB8HqOphr5NpyDsQ3BeQT5usF\0ADGweidAo0JAW3q/WpI2Mv5sVYnjc0tEftifkdpBDi5xtBtA3Z3aXVAde5WQ8TCNP\0AClm7CYw5pHuWTdPfxE3axretBRjW3Y5C59Hhc0LfjEtaVdALxkDWKBnjrvHBBDzm\0AfM5AmL6JxozRRiSlpP1Tv9R4rdwSZ9i2pkGe21FFDichkZkJrN+jZr3A+baq6/EV\0AjzjPRWpVi/r2cAUW0wVQrVeLAy7N2Kqlz78ZlXBB/d5lYxA2xgCUfduGSRgyCkG9\0A3fFNPQECgYEA1N2Gidmt9lrrjzFAW8bJ9PJTURXyYVdgwKPSLddw+h7/0xSkZH8j\0AihZ+Kr+ZhmIXeHGe5KIyCZ9MX7REDAvG0b0QHvr91Gs0uwXApAHluL7ZhOW8EONj\0AVPf7Z0ERG/wFnQRNsCf9irXEjdEWrwwXVt29EgQQTE8TGu5zxEVGCeUCgYEAzdY6\0AYt/zALbELuYElkXmIgA33zMqrShP37QzeOTDW/X6uwrK1v+aaB4DC208BzbZBEfX\0AgbHzNiEt+jWdwSYEDYGA53KkPBYphnLM6tW4wRiDrzS1ocu1xCBhCLD1JrOy4OnT\0AuUzbc1Y9RXOgi1qfM6fPCftIGWYZ34Izm7H1ZUMCgYA6fK+VusjQssSccITlcqZU\0A9iwsUGJrmo2MALckP1jccJ4MClTtA/3o2CtMZZ6yTMt0HYvx+BrVh/59IVO9F5NG\0AV7NRP9d0gQxZAsieh6Lt8wpjOJhG7